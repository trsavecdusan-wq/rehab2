<?xml version="1.0" encoding="utf-8"?>
<!-- Merged only into the "trial" build type. Adds a separate launcher entry for trial self-updates. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".trialupdate.TrialUpdateActivity"
            android:exported="true"
            android:label="rehab2 TEST posodobitev"
            android:taskAffinity="${applicationId}.trialupdate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
